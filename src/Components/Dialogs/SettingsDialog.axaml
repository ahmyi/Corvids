<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Corvids.SettingsDialog"
        Title="Settings" Icon="/Assets/icon.png"
        Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="20" Spacing="16">

    <CheckBox x:Name="RunAtStartupBox" />

    <CheckBox x:Name="StartMinimizedBox" Content="Start minimized to the tray"
              ToolTip.Tip="The window stays hidden after launch; apps flagged auto-start still start." />

    <StackPanel Spacing="4">
      <TextBlock x:Name="AppsFileLabel" Text="Apps config file" Opacity="0.7" />
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBox x:Name="AppsFileBox" FontFamily="{StaticResource MonoFont}" />
        <Button Grid.Column="1" Content="Browse..." Margin="6,0,0,0" Click="Browse_Click" />
        <Button Grid.Column="2" Content="Open folder" Margin="6,0,0,0" Click="OpenFolder_Click" />
      </Grid>
    </StackPanel>

    <StackPanel Spacing="4">
      <TextBlock x:Name="TerminalLabel" Text="Terminal command (optional)" Opacity="0.7" />
      <TextBox x:Name="TerminalBox" FontFamily="{StaticResource MonoFont}"
               Watermark="{} {dir} is replaced with the app folder" />
    </StackPanel>

    <StackPanel Spacing="4">
      <TextBlock Text="Log timestamp format" Opacity="0.7" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBox x:Name="TimestampBox" FontFamily="{StaticResource MonoFont}"
                 Watermark="%y-%m-%d %H:%M:%S" />
        <TextBlock Grid.Column="1" x:Name="TimestampPreview" VerticalAlignment="Center" Margin="10,0,0,0"
                   FontFamily="{StaticResource MonoFont}" Opacity="0.8" />
      </Grid>
      <TextBlock Text="Key for Date Time Input" FontSize="11" Opacity="0.55" Margin="0,2,0,0" />
      <Border Background="{DynamicResource LogBrush}" CornerRadius="4" Padding="10,8">
        <TextBlock x:Name="TimestampLegend" FontFamily="{StaticResource MonoFont}" FontSize="11" Opacity="0.75" />
      </Border>
    </StackPanel>

    <StackPanel Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <CheckBox x:Name="ControlApiBox" Content="Enable local control"
                  ToolTip.Tip="A loopback HTTP API on 127.0.0.1, guarded by a token. Lets agents/tools list and control apps." />
        <Button Content="ⓘ" Click="ControlInfo_Click" Padding="6,2" VerticalAlignment="Center"
                ToolTip.Tip="How to connect" />
      </StackPanel>
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="28,0,0,0" ColumnSpacing="8"
            IsEnabled="{Binding #ControlApiBox.IsChecked}">
        <TextBlock Text="Port" Opacity="0.7" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" x:Name="ControlPortBox" Width="72" FontFamily="{StaticResource MonoFont}" />
        <TextBlock Grid.Column="2" Text="Token" Opacity="0.7" VerticalAlignment="Center" Margin="8,0,0,0" />
        <TextBox Grid.Column="3" x:Name="ControlTokenBox" FontFamily="{StaticResource MonoFont}" IsReadOnly="True" />
        <Button Grid.Column="4" Content="Generate" Click="RegenerateToken_Click" />
      </Grid>
    </StackPanel>

    <TextBlock x:Name="ErrorText" Foreground="#F87171" IsVisible="False" TextWrapping="Wrap" />

    <DockPanel>
      <Button DockPanel.Dock="Left" Content="About" Click="About_Click" MinWidth="90"
              HorizontalContentAlignment="Center" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Cancel" Click="Cancel_Click" MinWidth="90" HorizontalContentAlignment="Center"
                IsCancel="True" />
        <Button Content="Save" Classes="accent" Click="Save_Click" MinWidth="90"
                HorizontalContentAlignment="Center" IsDefault="True" />
      </StackPanel>
    </DockPanel>

  </StackPanel>
</Window>
