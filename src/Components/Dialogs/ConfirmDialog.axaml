<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Corvids.ConfirmDialog" Icon="/Assets/icon.png"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="20" Spacing="16">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Click="Cancel_Click" MinWidth="90" HorizontalContentAlignment="Center"
              IsCancel="True" />
      <Button x:Name="ConfirmButton" Classes="accent" Click="Confirm_Click" MinWidth="90"
              HorizontalContentAlignment="Center" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
