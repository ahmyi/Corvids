<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Corvids"
        x:Class="Corvids.MainWindow"
        Title="Corvids" Icon="/Assets/icon.png"
        Width="1180" Height="720" MinWidth="760" MinHeight="440"
        WindowStartupLocation="CenterScreen">

  <Grid ColumnDefinitions="260,4,*">

    <!-- Sidebar: registered apps -->
    <DockPanel Grid.Column="0" Background="{DynamicResource SidebarBrush}">
      <StackPanel DockPanel.Dock="Top" Margin="12,12,12,6" Spacing="8">
        <TextBlock Text="Apps" FontSize="16" FontWeight="SemiBold" />
        <UniformGrid Columns="2">
          <Button Content="+ Add" Classes="accent" Click="AddApp_Click" Margin="0,0,3,0"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button Content="Start all" Click="StartAll_Click" Margin="3,0,0,0"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </UniformGrid>
      </StackPanel>

      <StackPanel DockPanel.Dock="Bottom" Margin="12,6,12,12" Spacing="6">
        <Button Content="Stop all" Click="StopAll_Click"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        <Button Content="Kill all node processes" Click="KillAllNode_Click"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                ToolTip.Tip="Kills every node process on this machine, including ones started from a terminal" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding VersionText}" FontSize="11" Opacity="0.45" VerticalAlignment="Center"
                     ToolTip.Tip="{Binding ConfigPath}" />
          <Button Grid.Column="1" Content="Settings" Click="Settings_Click" Padding="10,4" />
        </Grid>
      </StackPanel>

      <ListBox x:Name="AppList" ItemsSource="{Binding Apps}" SelectedItem="{Binding SelectedApp}"
               Background="Transparent" Margin="6,0">
        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Start" Click="Start_Click" IsEnabled="{Binding !SelectedApp.IsRunning}" />
            <MenuItem Header="Stop" Click="Stop_Click" IsEnabled="{Binding SelectedApp.IsRunning}" />
            <MenuItem Header="Restart" Click="Restart_Click" IsEnabled="{Binding SelectedApp.IsRunning}" />
            <MenuItem Header="Kill node" Click="KillNode_Click" />
            <Separator />
            <MenuItem Header="Open folder" Click="OpenFolder_Click" />
            <MenuItem Header="Edit" Click="EditApp_Click" />
            <MenuItem Header="Remove" Click="RemoveApp_Click" />
          </ContextMenu>
        </ListBox.ContextMenu>
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CornerRadius" Value="4" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="Auto,*">
              <Ellipse Width="9" Height="9" Margin="0,0,10,0" VerticalAlignment="Center"
                       Fill="{Binding Status, Converter={x:Static local:Converters.StatusToBrush}}" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding WorkingDirectory}" FontSize="11" Opacity="0.6"
                           TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding Command}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource DividerBrush}" />

    <!-- Empty state -->
    <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                IsVisible="{Binding SelectedApp, Converter={x:Static ObjectConverters.IsNull}}">
      <TextBlock Text="No apps yet" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <TextBlock Text="Click + Add to register a Node.js app (its folder and the command that runs it)."
                 Opacity="0.6" HorizontalAlignment="Center" />
    </StackPanel>

    <!-- Selected app: header, toolbar, log -->
    <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,*"
          IsVisible="{Binding SelectedApp, Converter={x:Static ObjectConverters.IsNotNull}}">

      <Border Grid.Row="0" Padding="16,12" Background="{DynamicResource SidebarBrush}"
              BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
        <StackPanel Spacing="3">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{Binding SelectedApp.Name}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SelectedApp.StatusText}" VerticalAlignment="Center"
                       Foreground="{Binding SelectedApp.Status, Converter={x:Static local:Converters.StatusToBrush}}" />
            <TextBlock Text="{Binding SelectedApp.Uptime}" VerticalAlignment="Center" Opacity="0.6" />
          </StackPanel>
          <TextBlock Text="{Binding SelectedApp.Command}" FontFamily="{StaticResource MonoFont}" Opacity="0.75" />
          <TextBlock Text="{Binding SelectedApp.WorkingDirectory}" FontSize="12" Opacity="0.5" />
        </StackPanel>
      </Border>

      <!-- Port conflict banner: shown when the log reports EADDRINUSE -->
      <Border Grid.Row="1" Margin="12,8,12,0" Padding="12,8" CornerRadius="4" Background="#3A2A1E"
              BorderBrush="#B45309" BorderThickness="1"
              IsVisible="{Binding SelectedApp.ConflictPort, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Text="{Binding SelectedApp.ConflictText}" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button Grid.Column="1" Classes="accent" Content="Kill it and restart" Margin="12,0,6,0"
                  Click="FreePort_Click" />
          <Button Grid.Column="2" Content="Dismiss" Click="DismissConflict_Click" />
        </Grid>
      </Border>

      <WrapPanel Grid.Row="2" Margin="12,8,12,6">
        <Button Classes="toolbar accent" Content="Start" Click="Start_Click"
                IsEnabled="{Binding !SelectedApp.IsRunning}" />
        <Button Classes="toolbar" Content="Stop" Click="Stop_Click" IsEnabled="{Binding SelectedApp.IsRunning}" />
        <Button Classes="toolbar" Content="Restart" Click="Restart_Click"
                IsEnabled="{Binding SelectedApp.IsRunning}" />
        <Button Classes="toolbar" Content="Kill node" Click="KillNode_Click"
                ToolTip.Tip="Stop this app and kill any other node process in its folder or on its port" />
        <Border Classes="separator" />
        <Button Classes="toolbar" Content="Clear" Click="Clear_Click" />
        <Button Classes="toolbar" Content="Copy all" Click="CopyAll_Click" />
        <Border Classes="separator" />
        <CheckBox Content="Auto-scroll" IsChecked="{Binding AutoScroll}" Margin="0,0,12,0" />
        <CheckBox Content="Wrap lines" IsChecked="{Binding WrapLines}" />
      </WrapPanel>

      <ListBox x:Name="LogList" Grid.Row="3" ItemsSource="{Binding SelectedApp.Lines}"
               SelectionMode="Multiple" Background="{DynamicResource LogBrush}"
               FontFamily="{StaticResource MonoFont}" FontSize="12"
               ScrollViewer.HorizontalScrollBarVisibility="{Binding LogHorizontalScroll}">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10,1" />
            <Setter Property="MinHeight" Value="0" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="{Binding TimeText}" Opacity="0.4" Margin="0,0,12,0" />
              <TextBlock Grid.Column="1" Text="{Binding Text}"
                         Foreground="{Binding Kind, Converter={x:Static local:Converters.LogKindToBrush}}"
                         TextWrapping="{Binding $parent[Window].LogWrapping}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Grid>
</Window>
